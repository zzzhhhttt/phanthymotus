# ── Jetson GPU variant ──────────────────────────────────────────────
# Base: jetson-base:jp511-torch (torch 2.0 + torchvision 0.15 with CUDA)
#
# Build context: repo root (phanthy-motus/) so we can access both
# src/perception_stack/ and deploy/ros-base/audio_msgs/
#
# Usage:
#   ./deploy/build_perception.sh --variant jetson --mirror tuna
# ────────────────────────────────────────────────────────────────────

ARG PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple/
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
ARG BASE_IMAGE=bj-warehouse.tencentcloudcr.com/phanthy-motus/jetson-base:jp511-torch
FROM ${BASE_IMAGE}
ARG PYPI_MIRROR APT_MIRROR

# ── APT mirror (conditional) ─────────────────────────────────────
RUN if [ -n "${APT_MIRROR}" ]; then \
        sed -i "s/archive.ubuntu.com/${APT_MIRROR}/g; s/ports.ubuntu.com/${APT_MIRROR}/g" /etc/apt/sources.list; \
    fi

# ── Switch ROS2 to TUNA mirror + skip expired key (if sources exist) ──
RUN if ls /etc/apt/sources.list.d/*.list 1>/dev/null 2>&1; then \
        sed -i 's|http://packages.ros.org/ros2/ubuntu|https://mirrors.tuna.tsinghua.edu.cn/ros2/ubuntu|g' /etc/apt/sources.list.d/*.list && \
        sed -i 's|deb \[|deb [trusted=yes |g; s|deb http|deb [trusted=yes] http|g' /etc/apt/sources.list.d/ros2*.list; \
    fi

# ── System deps ────────────────────────────────────────────────────
RUN rm -f /etc/apt/sources.list.d/* && rm -rf /var/cache/apt/archives/* /var/lib/apt/lists/* && \
    apt-get -o Acquire::AllowInsecureRepositories=true update && \
    apt-get install -y --no-install-recommends --allow-unauthenticated ffmpeg && \
    apt-get clean && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

RUN pip3 install --no-cache-dir -i ${PYPI_MIRROR} colcon-common-extensions && \
    pip3 install --no-cache-dir -i ${PYPI_MIRROR} "empy<4"

# ── audio_msgs ROS2 package (Humble already in base) ──────────────
COPY deploy/ros-base/audio_msgs/ /ros_ws/src/audio_msgs/
RUN cd /ros_ws && \
    . /opt/ros/humble/install/setup.bash && \
    colcon build --packages-select audio_msgs --cmake-args -DCMAKE_BUILD_TYPE=Release

# ── Python deps ────────────────────────────────────────────────────
RUN pip3 install --no-cache-dir -i ${PYPI_MIRROR} \
    pyyaml requests websockets webrtcvad websocket-client dashscope && \
    pip3 install --no-cache-dir --no-deps -i ${PYPI_MIRROR} silero-vad

# ── HTMSG deps (KISS-ICP + future semantic) ──────────────────────
RUN pip3 install --no-cache-dir -i ${PYPI_MIRROR} \
    kiss-icp scipy

# ── VOP deps (YOLOv8-World object detection) ─────────────────────
# Fix broken system cv2 __init__.py (mat_wrapper circular import on Jetson)
RUN python3 -c "import cv2" 2>/dev/null || { \
    echo 'import importlib.util, sys, os' > /usr/lib/python3.8/dist-packages/cv2/__init__.py && \
    echo '_so = os.path.join(os.path.dirname(__file__), "python-3.8", "cv2.cpython-38-aarch64-linux-gnu.so")' >> /usr/lib/python3.8/dist-packages/cv2/__init__.py && \
    echo '_spec = importlib.util.spec_from_file_location("cv2", _so)' >> /usr/lib/python3.8/dist-packages/cv2/__init__.py && \
    echo '_mod = importlib.util.module_from_spec(_spec)' >> /usr/lib/python3.8/dist-packages/cv2/__init__.py && \
    echo '_spec.loader.exec_module(_mod)' >> /usr/lib/python3.8/dist-packages/cv2/__init__.py && \
    echo 'sys.modules["cv2"] = _mod' >> /usr/lib/python3.8/dist-packages/cv2/__init__.py; \
    }
# Install ultralytics WITHOUT replacing Jetson's CUDA torch + torchvision
RUN pip3 install --no-cache-dir --no-deps -i ${PYPI_MIRROR} ultralytics && \
    pip3 install --no-cache-dir -i ${PYPI_MIRROR} \
    matplotlib pandas tqdm "pillow>=7.1.2" psutil py-cpuinfo \
    "ultralytics-thop>=0.2.7" "seaborn>=0.11.0" && \
    pip3 uninstall -y opencv-python opencv-python-headless 2>/dev/null; true
# ultralytics CLIP (GitHub via mirror, needed for set_classes)
RUN pip3 install --no-cache-dir --no-deps "git+https://ghfast.top/https://github.com/ultralytics/CLIP.git" && \
    pip3 install --no-cache-dir -i ${PYPI_MIRROR} ftfy regex

# Pre-download CLIP weights into image (avoids 338MB download at runtime)
RUN mkdir -p /work/weights/clip && \
    python3 -c "import urllib.request; urllib.request.urlretrieve('https://agi-phanthy-dev-1252788780.cos.ap-beijing.myqcloud.com/public/ViT-B-32.pt', '/work/weights/clip/ViT-B-32.pt')"

# Set YOLO_CONFIG_DIR so WEIGHTS_DIR resolves to /work/weights
ENV YOLO_CONFIG_DIR=/work

# ── sherpa-onnx (on-device ASR/TTS/KWS) ──────────────────────────
RUN pip3 install --no-cache-dir -i ${PYPI_MIRROR} sherpa-onnx

# ── phonemizer (multilingual IPA via espeak-ng for asr_kws mode) ──
RUN apt-get update && apt-get install -y --no-install-recommends espeak-ng && \
    rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir -i ${PYPI_MIRROR} phonemizer

# ── OCR deps (PP-OCRv6_tiny via PaddleOCR, onnxruntime backend) ───
# 新版榜单文档明确写了"必须使用GPU"，是硬性要求，不是"CPU也在预算内所以
# 随便选"——之前这里默认装 CPU 版 onnxruntime 就不合规了，改成优先装
# onnxruntime-gpu。
#
# 没法在这台开发机（x86_64）上验证 Jetson（aarch64 + JetPack 5.1.1）
# 到底有没有对应的 onnxruntime-gpu wheel——Jetson 用的是 Tegra 定制版
# CUDA/cuDNN，跟标准 PyPI 上 onnxruntime-gpu 面向的数据中心 CUDA 不是
# 同一套 ABI，就算 pip 能找到 aarch64 wheel 装上，也可能在真正调用时
# 报 CUDA 版本不匹配、而不是在装的时候就报错（本地 x86_64 上实测就复现
# 了这个问题：装上 onnxruntime-gpu 后能 import，但建 InferenceSession
# 时因为缺运行时库静默退回 CPU）。真正"装的这个到底能不能用 GPU"的验证，
# 挪到后面模型文件 COPY 完之后（见下面"验证 OCR 是否真的在用 GPU"那段），
# 需要你在 jetson 盒子上 build 时親眼确认那一步的输出。
#
# focal（这个基础镜像的系统版本）的 apt 源里没有 libffi8 —— 这个包是从
# Ubuntu 22.04(jammy) 才开始有的，focal 上根本找不到，不是镜像源配置问题。
# 直接从 jammy 的 ports 源下载对应 .deb，手动装，不走 apt 依赖解析。
RUN apt-get update && apt-get install -y --no-install-recommends wget && \
    wget -q http://mirrors.tuna.tsinghua.edu.cn/ubuntu-ports/pool/main/libf/libffi/libffi8_3.4.2-4_arm64.deb -O /tmp/libffi8.deb && \
    dpkg -i /tmp/libffi8.deb && \
    rm -f /tmp/libffi8.deb && \
    rm -rf /var/lib/apt/lists/*

# 注意：这里不做"装完就验证 CUDAExecutionProvider"，因为
# onnxruntime.get_available_providers() 只反映"编译时带了这个 provider"，
# 不代表运行时真的能加载——本地实测过：onnxruntime-gpu 装上之后
# get_available_providers() 照样列出 CUDAExecutionProvider，但实际建
# InferenceSession 时因为缺 libcublasLt.so.12 之类的运行时库，会静默
# 退回 CPUExecutionProvider，session.get_providers() 才是唯一可信的
# "实际在用哪个 provider" 的检查方式，而这一步需要一个真实 onnx 文件才能
# 测，模型文件要等下面 COPY 完才有，所以真正的验证挪到那之后（见下面
# "验证 OCR 是否真的在用 GPU" 那一段），这里先只管装上。
RUN pip3 install --no-cache-dir --ignore-installed PyYAML -i ${PYPI_MIRROR} \
    paddleocr onnxruntime-gpu
# 上面这行会把 opencv-contrib-python 当成 paddlex[ocr-core] 的依赖一起装上，
# 但这份 pip 装的 cv2（具体是它的 gapi 子模块）在这个环境下有已知的坏导入
# bug（AttributeError: gapi_wip_gst_GStreamerPipeline），装不装都不对：
#   - 装（保留文件）→ import cv2 直接崩
#   - 卸载（连元数据一起删）→ paddlex 自己的依赖检查过不去，报 DependencyError
# 折中方案：保留 pip 的安装记录（元数据/RECORD，满足依赖检查），但物理删掉
# 它装的那份坏 cv2 包文件本体，这样 import cv2 时 Python 会往 sys.path 后面
# 找，落到系统自带、已经在上面 VOP 那段修过的那份 cv2 上，两边各取所需。
RUN rm -rf /usr/local/lib/python3.8/dist-packages/cv2
# 上面这行删完，import cv2 会落到系统那份（/usr/lib/.../cv2/），但这份在
# 实测中发现，只要真正跑到 bootstrap() 里加载 gapi 子模块这一步，会撞上
# 同一个 gapi_wip_gst_GStreamerPipeline 的坏导入（这个 wheel 编译时没带
# GStreamer 支持，但 gapi/__init__.py 的 Python 包装代码不管有没有编译
# 进去都会去引用这个符号）。VOP 那段已有的修复只在它检测到 mat_wrapper
# 那个具体错误时才生效，不覆盖这个 gapi 问题，这里再补一刀、无条件跳过
# bootstrap() 里那套逐子模块加载 extra py 代码的机制，直接加载编译好的
# .so 扩展本体（gapi 属于用不上的图执行 API，OCR 预处理不需要它）。
RUN CV2_SO=$(find /usr/lib/python3.8/dist-packages/cv2 -name "cv2.cpython-38-*-linux-gnu.so" | head -1) && \
    test -n "$CV2_SO" && \
    echo "import importlib.util, sys" > /usr/lib/python3.8/dist-packages/cv2/__init__.py && \
    echo "_spec = importlib.util.spec_from_file_location('cv2', '$CV2_SO')" >> /usr/lib/python3.8/dist-packages/cv2/__init__.py && \
    echo "_mod = importlib.util.module_from_spec(_spec)" >> /usr/lib/python3.8/dist-packages/cv2/__init__.py && \
    echo "_spec.loader.exec_module(_mod)" >> /usr/lib/python3.8/dist-packages/cv2/__init__.py && \
    echo "sys.modules['cv2'] = _mod" >> /usr/lib/python3.8/dist-packages/cv2/__init__.py
RUN python3 -c "import cv2; print('system cv2 OK, version', cv2.__version__)"

# ── Application code ───────────────────────────────────────────────
WORKDIR /work
COPY perception/main.py    /work/main.py
COPY perception/plugins/   /work/plugins/
COPY perception/utils/     /work/utils/
COPY perception/config.yaml /work/config.yaml
COPY perception/config/fastdds_large_message.xml /opt/phanthy-motus/config/fastdds_large_message.xml

# OCR 模型直接从仓库打进镜像（每个文件都在 10MB 以内），不用运行时再去
# JuiceFS 下载 —— ensure_model() 发现这些路径下文件已经存在，会自动
# 跳过下载这一步。
COPY perception/models/ppocr/PP-OCRv6_tiny_det_onnx/ /opt/models/ppocr/PP-OCRv6_tiny_det/
COPY perception/models/ppocr/PP-OCRv6_small_det_onnx/ /opt/models/ppocr/PP-OCRv6_small_det/
COPY perception/models/ppocr/PP-OCRv6_tiny_rec_onnx/ /opt/models/ppocr/PP-OCRv6_tiny_rec/

# 验证 OCR 是否真的在用 GPU（榜单硬性要求）。用真实模型文件建
# InferenceSession，看 session.get_providers()[0] 是不是
# CUDAExecutionProvider——这是唯一可信的检查方式（见前面 pip install
# 那段注释：get_available_providers() 会骗人）。这里不让 build 失败
# （万一 build 阶段本身没有 GPU/CUDA 库访问权限——取决于 Jetson 的
# Docker daemon 有没有配置 default-runtime=nvidia，跟容器真正 docker
# run 时能不能用 GPU 是两回事），只是把结果显眼地打印到 build 日志里，
# 需要你在 jetson 盒子上 build 时親眼确认这一行输出的是 CUDA 还是 CPU。
RUN python3 -c "\
import onnxruntime as ort; \
sess = ort.InferenceSession('/opt/models/ppocr/PP-OCRv6_small_det/inference.onnx', providers=['CUDAExecutionProvider', 'CPUExecutionProvider']); \
providers = sess.get_providers(); \
print('=' * 70); \
print('[ocr] onnxruntime actual providers in use:', providers); \
print('[ocr] GPU requirement SATISFIED' if providers[0] == 'CUDAExecutionProvider' else '[ocr] WARNING: GPU requirement NOT satisfied — running on CPU despite onnxruntime-gpu install. Needs a JetPack-matched onnxruntime build (Jetson Zoo), not plain PyPI onnxruntime-gpu.'); \
print('=' * 70) \
"

EXPOSE 15720
EXPOSE 15721

# 确保 ROS2 Python 包始终在 PYTHONPATH 中（不依赖 source setup.bash）
RUN find /ros_ws/install -name "site-packages" -type d > /usr/local/lib/python3.8/dist-packages/ros_ws.pth && \
    find /opt/ros/humble/install -name "site-packages" -type d >> /usr/local/lib/python3.8/dist-packages/ros_ws.pth

# ROS2 shared libraries（audio_msgs .so 等）
ENV LD_LIBRARY_PATH="/ros_ws/install/audio_msgs/lib:/opt/ros/humble/install/lib:${LD_LIBRARY_PATH}"
ENV AMENT_PREFIX_PATH="/ros_ws/install/audio_msgs:/opt/ros/humble/install"

CMD ["/bin/bash", "-c", \
    "export LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libgomp.so.1 && \
     source /opt/ros/humble/install/setup.bash && \
     source /ros_ws/install/setup.bash && \
     python3 /work/main.py"]